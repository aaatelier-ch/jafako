<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 7 ships RhinoCommon for .NET Framework 4.8; on modern SDKs net7.0
         is used for the cross-platform Mac build. Adjust to match your Rhino. -->
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- A Rhino plugin is just a renamed .dll -->
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>

    <AssemblyName>VisualARQMac</AssemblyName>
    <RootNamespace>VisualARQMac</RootNamespace>
    <Version>1.0.0</Version>
    <Company>VisualARQ-Mac Open Source Community</Company>
    <Description>Open-source BIM plugin for Rhino 7 macOS</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- RhinoCommon SDK + Grasshopper, supplied by McNeel via NuGet. -->
    <PackageReference Include="RhinoCommon" Version="7.0.20314.3001" IncludeAssets="compile" />
    <PackageReference Include="Grasshopper" Version="7.0.20314.3001" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <None Include="VisualARQMac.info" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
